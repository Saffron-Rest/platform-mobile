# Copy to mobile/.env.firebase and fill in. NEVER commit the real file.
#
# Firebase App Distribution app IDs (Firebase console → Project Settings → General
# → "Your apps" → the value labelled "App ID", e.g. 1:1234567890:android:abcdef…).

FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxxxxxxxxxxxxxx
FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxxxxxxxxxxxxxx

# Comma-separated tester groups created in Firebase console → App Distribution → Testers & groups.
FIREBASE_GROUPS=testers

# Auth — pick ONE of the two below.
#
# (1) Service account JSON (recommended for CI). Path to a file with role
#     "Firebase App Distribution Admin" on the project. Don't paste contents here.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# (2) Legacy CI token. Generate with: `firebase login:ci`
# FIREBASE_TOKEN=
